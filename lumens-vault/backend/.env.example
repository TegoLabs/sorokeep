# Stellar Soroban RPC endpoint URL (http:// or https://)
RPC_URL=

# Stellar network passphrase (e.g. "Test SDF Network ; September 2015")
NETWORK_PASSPHRASE=

# Deployed Lumens Vault Soroban contract ID (56-character C... StrKey)
CONTRACT_ID=

# SQLite database file path (or :memory: for tests)
DATABASE_PATH=

# Shared HMAC secret used to sign outgoing webhook payloads (never logged)
WEBHOOK_SECRET=

# Reflector oracle contract ID on the target Stellar network (56-character C... StrKey)
REFLECTOR_CONTRACT_ID=

# HTTP server port (1-65535, defaults to 3000 when omitted)
PORT=